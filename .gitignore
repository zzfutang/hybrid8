__pycache__/
*.py[cod]
.venv/
venv/
.env
.idea/
.vscode/
.DS_Store
dist/
build/

# Xcode per-user state
*.xcuserstate
xcuserdata/

# Local audio assets / scratch archives (not part of the build)
*.wav
*.zip

# ...except R50's sample folder, which is source: those files are built into
# the plugin and are meant to be edited and reviewed like any other asset.
# The factory tree nests one directory per multisampled instrument, so the
# exception has to reach into subdirectories too — but not into
# old_factory_samples, which is a local archive of the retired content.
!Products/R50/Samples/*.wav
!Products/R50/factory_samples/*.wav
!Products/R50/factory_samples/**/*.wav

# Editor backup files
*~