__pycache__/
*.py[cod]
.venv/
venv/
.env
.idea/
.vscode/
.DS_Store
dist/
build/

# Xcode per-user state
*.xcuserstate
xcuserdata/

# Local audio assets / scratch archives (not part of the build)
*.wav
*.zip

# ...except R50's factory audio, which ships with the plugin and is tracked
# through Git LFS -- see .gitattributes. Git itself only carries a pointer per
# sample, so the ~68 MB of audio never enters the repository's history.
#
# old_factory_samples is deliberately left out: it is a local archive of
# retired content, not something the build or the tests read.
!Products/R50/Samples/*.wav
!Products/R50/factory_samples/*.wav
!Products/R50/factory_samples/**/*.wav

# Editor backup files
*~